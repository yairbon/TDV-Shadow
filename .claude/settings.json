{
  "$comment": "Project settings. The same hooks are declared in .claude-plugin/hooks.json for when TDV-Shadow is consumed as a plugin; these entries make them active for anyone working in this repo directly.",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude-plugin/hooks/precompact-preserve-math.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude-plugin/hooks/guard-dom-in-renderer.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude-plugin/hooks/check-silent.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
